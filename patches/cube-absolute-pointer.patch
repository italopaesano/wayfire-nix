+        rotate_cube(ev->event->delta_x, ev->event->delta_y);
+        last_pointer_position = {};
 
         ev->event->delta_x    = 0;
         ev->event->delta_y    = 0;
@@ -694,15 +727,15 @@ class wayfire_cube : public wf::per_output_plugin_instance_t, public wf::pointer
         ev->event->unaccel_dy = 0;
